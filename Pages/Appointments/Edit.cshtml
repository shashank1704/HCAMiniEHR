@page
@model HCAMiniEHR.Pages.Appointments.EditModel

<h2>Edit Appointment</h2>

<form method="post">
    <input type="hidden" asp-for="Appointment.AppointmentID" />
    
    <div class="mb-2">
        <label>Patient</label>
        <select asp-for="Appointment.PatientID"
                asp-items="Model.PatientList"
                class="form-control"></select>
    </div>

    <div class="mb-2">
        <label>Appointment Date</label>
        <input asp-for="Appointment.AppointmentDate"
               type="datetime-local"
               class="form-control"
               required />
    </div>

    <div class="mb-2">
        <label>Doctor Name</label>
        <select asp-for="Appointment.DoctorName"
                asp-items="Model.DoctorList"
                class="form-control">
            <option value="">-- Select Doctor --</option>
        </select>
        <span asp-validation-for="Appointment.DoctorName" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label>Status</label>
        <select asp-for="Appointment.Status" class="form-control">
            <option value="Scheduled">Scheduled</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <button class="btn btn-primary">Update</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
