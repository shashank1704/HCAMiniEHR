@page
@model HCAMiniEHR.Pages.Appointments.CreateModel

<h2>Create Appointment</h2>

<form method="post">
    <div class="mb-2">
        <label>Patient</label>
        <select asp-for="Appointment.PatientID"
                asp-items="Model.PatientList"
                class="form-control"></select>
    </div>

    <div class="mb-2">
        <label>Appointment Date</label>
        <input asp-for="Appointment.AppointmentDate"
               type="datetime-local"
               class="form-control"
               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
               required />
    </div>

    <div class="mb-2">
        <label>Doctor Name</label>
        <select asp-for="Appointment.DoctorName"
                asp-items="Model.DoctorList"
                class="form-control">
            <option value="">-- Select Doctor --</option>
        </select>
        <span asp-validation-for="Appointment.DoctorName" class="text-danger"></span>
    </div>
    <button class="btn btn-success">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>

