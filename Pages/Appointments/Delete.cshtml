@page
@model HCAMiniEHR.Pages.Appointments.DeleteModel

<h2>Delete Appointment</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Patient
        </dt>
        <dd class="col-sm-10">
            @Model.Appointment.Patient?.FirstName @Model.Appointment.Patient?.LastName
        </dd>
        <dt class="col-sm-2">
            Date
        </dt>
        <dd class="col-sm-10">
            @Model.Appointment.AppointmentDate
        </dd>
        <dt class="col-sm-2">
            Doctor
        </dt>
        <dd class="col-sm-10">
            @Model.Appointment.DoctorName
        </dd>
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @Model.Appointment.Status
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Appointment.AppointmentID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
