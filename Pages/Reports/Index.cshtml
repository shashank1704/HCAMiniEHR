@page
@model HCAMiniEHR.Pages.Reports.IndexModel

<h2>Reports Dashboard</h2>

<hr />

<!-- ================= Pending Lab Orders ================= -->
<h4>📌 Pending Lab Orders</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Test Name</th>
            <th>Appointment ID</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.PendingLabOrders)
        {
            <tr>
                <td>@item.TestName</td>
                <td>@item.AppointmentID</td>
            </tr>
        }
    </tbody>
</table>

<hr />

<!-- ================= Patients Without Follow-Up ================= -->
<h4>📌 Patients Without Follow-Up</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Patient Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.PatientsWithoutFollowUp)
        {
            <tr>
                <td>@item.PatientName</td>
            </tr>
        }
    </tbody>
</table>

<hr />

<!-- ================= Appointments Per Day ================= -->
<h4>📌 Appointments Per Day</h4>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Date</th>
            <th>Total Appointments</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.AppointmentsPerDay)
        {
            <tr>
                <td>@item.Date.ToShortDateString()</td>
                <td>@item.Count</td>
            </tr>
        }
    </tbody>
</table>

